# Environment Configuration for AI Shorts Studio
# Copy this file to .env and adjust variables as needed

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# SQLite Database
DATABASE_URL=sqlite:///./storage/studio.sqlite3

# Storage Paths
STORAGE_DIR=./storage
JOBS_STORAGE_DIR=./storage/jobs

# Google Gemini / Veo Video Generation API Configuration
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Official Google Video Generation Model (e.g. gemini-omni-1.1-flash or veo-2.0-generate-001)
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
# Provider mode: "flow_browser" for Chrome CDP automation, "gemini" for API, or "mock" for offline testing
VIDEO_GENERATION_PROVIDER=flow_browser
CDP_DEBUGGING_URL=http://127.0.0.1:9222
FLOW_URL=https://labs.google/fx/tools/flow
FLOW_SCENE_TIMEOUT_SECONDS=180
VIDEO_POLL_INTERVAL_SECONDS=10
VIDEO_MAX_POLL_TIMEOUT_SECONDS=360
VIDEO_ASPECT_RATIO=9:16

# Narration language: "hinglish" (Roman-script Hindi) or "en-us"
NARRATION_LANGUAGE=hinglish

# TTS voice. Neural voices go to edge-tts (needs internet):
#   hi-IN-MadhurNeural (male)  |  hi-IN-SwaraNeural (female)
# Names like af_bella / am_adam go to local offline Kokoro (English).
DEFAULT_VOICE=hi-IN-MadhurNeural
TTS_SPEED=1.0
# Fail loudly if edge-tts is unreachable (instead of reading Hindi with English phonemes)
TTS_ALLOW_KOKORO_FALLBACK=False

# Local TTS (Kokoro) Configuration
KOKORO_VOICE=am_adam
KOKORO_LANG=en-us
KOKORO_SPEED=1.0

# Downloads folder watcher (auto-collects scene_01.mp4 ... from Google Flow downloads)
DOWNLOADS_WATCH_ENABLED=True
# DOWNLOADS_DIR=C:/Users/<you>/Downloads
DOWNLOADS_POLL_SECONDS=2.0
DOWNLOADS_STABLE_SECONDS=2.0

# Subtitle Styling Configuration (9:16 Shorts)
SUBTITLE_FONT_NAME=Arial Black
SUBTITLE_FONT_SIZE=72
SUBTITLE_ACTIVE_COLOR=&H0000FFFF&
SUBTITLE_INACTIVE_COLOR=&H00FFFFFF&
SUBTITLE_OUTLINE_WIDTH=6
SUBTITLE_MARGIN_V=650
SUBTITLE_WORDS_PER_CHUNK=3

# Hardware / Rendering Constraints (HP Victus RTX 3050 Laptop)
HARDWARE_ACCELERATION=nvenc
MAX_VRAM_GB=4
MAX_RAM_GB=16
